# Supabase — copier ce fichier en `.env` et remplir avec les valeurs du projet
# (Dashboard Supabase > Project Settings > API).
# Préfixe EXPO_PUBLIC_ requis : Metro inline ces vars dans le bundle client.
# La clé anon est publique par design (la sécurité repose sur les politiques RLS).
# URL de l'API (https://<ref>.supabase.co), PAS l'URL du dashboard supabase.com/dashboard/...
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
